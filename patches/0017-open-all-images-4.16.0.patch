+            thumb.style.cssText = "width:100%;height:100%;object-fit:cover;display:block;";
+            thumb.src = url;
+            var badge = document.createElement("span");
+            badge.textContent = String(index + 1);
+            badge.style.cssText = "position:absolute;top:4px;left:4px;min-width:20px;height:20px;line-height:20px;text-align:center;border-radius:10px;background:rgba(0,0,0,.62);color:#fff;font-size:12px;font-weight:bold;padding:0 5px;";
+            cell.append(thumb, badge);
