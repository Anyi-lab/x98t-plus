+
+        urls.forEach(function (url, index) {
+            var cell = document.createElement("a");
+            cell.href = url;
+            cell.target = "_blank";
+            cell.rel = "noopener noreferrer";
+            cell.style.cssText = "position:relative;display:block;aspect-ratio:1/1;border:1px solid #eee;border-radius:6px;overflow:hidden;background:#f6f6f6;";
+            var thumb = document.createElement("img");
+            // 用 setAttribute 而不是 IDL 属性：老浏览器/测试环境里 loading 这类
