+    // #region 一键打开全部图片（帖子页）
+    // 帖子正文常常一次贴十几二十张图（截图里那种 1..20 的编号），
+    // 想存下来只能一张张点。这里给一个入口：把正文里所有图收齐，
+    // 在一个浮层里全部列出来，支持「全部新标签打开」和「复制全部链接」。
+    var IMAGE_URL_RE = /\.(jpe?g|png|gif|webp|bmp|avif)(\?|#|$)/i;
+    var IMAGE_NOISE_RE = /static\/image\/(?:smiley|common)|avatar|\/uc_server\/|none\.gif|smiley/i;
+
+    function collectThreadImages() {
+        var seen = Object.create(null);
+        var result = [];
+        var add = function (url) {
+            if (!url || !/^https?:\/\//i.test(url)) return;
+            if (IMAGE_NOISE_RE.test(url)) return;
+            // 图床地址常常没有扩展名（tu.xxx/tupian/forum/202610/21/xxx），
+            // 所以「有扩展名」或「明显是图床/附件路径」都收。
+            if (!IMAGE_URL_RE.test(url) && !/tupian|attachment|\/forum\/\d{6}|tu\./i.test(url)) return;
+            if (seen[url]) return;
+            seen[url] = true;
+            result.push(url);
+        };
+        document.querySelectorAll("img").forEach(function (img) {
+            if (!isPostContentImage(img)) return;
+            add(getOriginalImageURL(img));
+        });
+        // 有些模板正文里给的是 <a href="....jpg"> 而不是 <img>
+        document.querySelectorAll(".t_f a[href], [id^='postmessage_'] a[href], .pcb a[href], .message a[href]").forEach(function (a) {
+            var href = a.getAttribute("href") || "";
+            if (!IMAGE_URL_RE.test(href)) return;
+            try { add(new URL(href, location.href).href); } catch (error) {}
+        });
+        return result;
+    }
+
