+        document.addEventListener("keydown", onKeyDown, true);
+        document.body.appendChild(overlay);
+    }
+
+    function insertOpenAllImagesButton(buttonContainer) {
+        if (!buttonContainer || document.getElementById("bgshOpenAllImagesButton")) return;
+        var button = createButton("bgshOpenAllImagesButton", "🖼️ 全部图片", openAllThreadImages);
