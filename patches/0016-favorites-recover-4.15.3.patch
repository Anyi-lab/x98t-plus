+    // 或者把条目降级成「未分类」但目录清单本身还在别处。
+    // 这里把本地所有 bgsh_* 键扫一遍，能捞的都捞回来 —— 不联网、只动本地存储。
+    function recoverFavoriteStorage() {
+        if (!favKeys) return { folders: 0, entries: 0, keys: 0 };
+        var keys = typeof GM_listValues === "function" ? (GM_listValues() || []) : [];
+        var folderUnion = [];
+        var favSources = [];
+        var addFolder = function (f) {
+            f = String(f || "").trim();
+            if (!f || f.charAt(0) !== "/") return;
+            if (folderUnion.indexOf(f) < 0) folderUnion.push(f);
+        };
+        addFolder("/");
+        folders.forEach(addFolder);
+        keys.forEach(function (key) {
+            if (key === favKeys.favs || key === favKeys.folders || key === favKeys.backup) return;
+            if (/^bgsh_folders_\d+$/.test(key)) {
+                var arr = getJSONValue(key, []);
+                if (Array.isArray(arr)) arr.forEach(addFolder);
+            } else if (/^bgsh_favs_backup_\d+$/.test(key)) {
+                var bk = getJSONValue(key, null);
+                if (bk && Array.isArray(bk.folders)) bk.folders.forEach(addFolder);
+                if (bk && bk.favs && typeof bk.favs === "object") favSources.push(bk.favs);
+            } else if (/^bgsh_favs_\d+$/.test(key)) {
+                var src = getJSONValue(key, {});
+                if (src && typeof src === "object" && !Array.isArray(src)) favSources.push(src);
+            }
+        });
+        var collectFrom = function (map) {
+            if (!map || typeof map !== "object") return;
+            Object.keys(map).forEach(function (k) {
+                var f = map[k] && map[k].folder;
+                if (f) addFolder(f);
+            });
+        };
+        collectFrom(favCache);
+        favSources.forEach(collectFrom);
+
+        var addedFolders = 0;
+        folderUnion.forEach(function (f) {
+            if (folders.indexOf(f) < 0) { folders.push(f); addedFolders++; }
+        });
+
+        var recovered = 0;
+        favSources.forEach(function (src) {
+            Object.keys(src).forEach(function (favid) {
+                var donor = src[favid];
+                if (!donor || typeof donor !== "object") return;
+                var mine = favCache[favid];
+                if (!mine) {
+                    favCache[favid] = donor;
+                    if (donor.folder && folders.indexOf(donor.folder) < 0) folders.push(donor.folder);
+                    recovered++;
+                    return;
+                }
+                // 本地条目被降级成「未分类」、别的键里还留着原目录 —— 还原它
+                if ((!mine.folder || mine.folder === "/") && donor.folder && donor.folder !== "/") {
+                    mine.folder = donor.folder;
+                    if (folders.indexOf(donor.folder) < 0) folders.push(donor.folder);
+                    recovered++;
+                }
+                if (!mine.title && donor.title) mine.title = donor.title;
+                if (!mine.url && donor.url) mine.url = donor.url;
+                if (!mine.author && donor.author) mine.author = donor.author;
+            });
+        });
+        saveFavoriteData();
+        return { folders: addedFolders, entries: recovered, keys: keys.length };
+    }
